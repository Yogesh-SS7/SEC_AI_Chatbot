# ─────────────────────────────────────────────
#  SEC_AI_Chatbot — Environment Configuration TEMPLATE
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Ollama API
OLLAMA_URL=YOUR_OLLAMA_API_URL_HERE
MODEL_NAME=YOUR_MODEL_NAME_HERE

# System Prompt
# Options: "vulnerable_system_prompt.txt" | "secure_system_prompt.txt"
ACTIVE_PROMPT_FILE=YOUR_PROMPT_FILE_HERE

# Application
HOST=0.0.0.0
PORT=8000
UPLOAD_DIR=YOUR_UPLOAD_DIR_HERE

# ── Phase 2: Authentication ────────────────────────────────────────────────────
JWT_SECRET_KEY=YOUR_SECURE_RANDOM_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
APP_USERNAME=admin
APP_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# ── Phase 3: Abuse Prevention ──────────────────────────────────────────────────
RATE_LIMIT_CHAT=10/minute
RATE_LIMIT_UPLOAD=5/minute
RATE_LIMIT_TOKEN=5/minute

# Request / response size limits
MAX_REQUEST_SIZE_BYTES=5767168
MAX_PROMPT_CHARS=4000
MAX_RESPONSE_CHARS=8000

# Ollama timeout (seconds)
OLLAMA_TIMEOUT=60
