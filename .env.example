# System Prompt
# Options: "vulnerable_system_prompt.txt" | "secure_system_prompt.txt"
ACTIVE_PROMPT_FILE=YOUR_PROMPT_FILE_HERE

# Application
HOST=0.0.0.0
PORT=8000
UPLOAD_DIR=YOUR_UPLOAD_DIR_HERE
