# ─────────────────────────────────────────────
#  SEC_AI_Chatbot — Environment Configuration TEMPLATE
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Ollama API
OLLAMA_URL=http://localhost:11434/api/chat
MODEL_NAME=llama3.2

# System Prompt
# Options: "vulnerable_system_prompt.txt" | "secure_system_prompt.txt"
ACTIVE_PROMPT_FILE=secure_system_prompt.txt

# Application
HOST=0.0.0.0
PORT=8000
UPLOAD_DIR=uploads
